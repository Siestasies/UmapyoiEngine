local originalPosX
local originalScaleX

function Start()
    local transform = GetTransform()
    originalPosX = transform.worldPosition.x
    originalScaleX = transform.scale.x

    Log("[HB DEBUG] Start")
    Log("[HB DEBUG] originalPosX:" .. originalPosX)
    Log("[HB DEBUG] originalScaleX:" .. originalScaleX)
end
  
function Update(dt)
      local parentID = GetParent(EntityID)
      --local enemy = GetEnemyFrom(parentID)

      if parentID == -1 then
          Log("[HB] parentID is -1 for entity " .. tostring(EntityID))
          return
      end

      local enemy = GetEnemyFrom(parentID)
      if not enemy then
          Log("[HB] enemy is nil, parentID=" .. tostring(parentID))
          return
      end

      if enemy then
          local currentHealth = enemy.mHealth
          local maxHealth = enemy.mMaxHealth

          local ratio = 0
          if maxHealth > 0 then
              ratio = currentHealth / maxHealth
          end

          if ratio < 0 then ratio = 0 end
          if ratio > 1 then ratio = 1 end

          local transform = GetTransform()

          local lost = originalScaleX * (1 - ratio)
          transform.scale    = Vec2(originalScaleX * ratio, transform.scale.y)
          transform.position = Vec2(originalPosX - (lost / 2), transform.position.y)
      end
  end
